# Space Shooter Odyssey - Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
GAME_TITLE=SPACE SHOOTER ODYSSEY

# Database: specify a MongoDB connection string, or leave empty to use built-in in-memory MongoDB
MONGODB_URI=

# Security
JWT_SECRET=super_secret_jwt_key_space_shooter_odyssey_dev_2026
ADMIN_SECRET_KEY=admin_master_secret_odyssey_2026

# VELoop Rewards Platform Configuration
# Modes: development_mock | sandbox | production
VELOOP_MODE=development_mock
VELOOP_API_KEY=mock-veloop-api-key-internal
VELOOP_REWARDS_ENABLED=true
VELOOP_MAX_DAILY_COINS=500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
