{
  "name": "space-shooter-odyssey-backend",
  "version": "1.0.0",
  "description": "Full-Stack Server-Authoritative Backend for Space Shooter Odyssey - VELoop Rewards Game",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
